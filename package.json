{
  "name": "folder-tree-sh",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent workspace file tree: explorer panel, preview (text/docx/image/PDF), context menu operations",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "mammoth": "^1.11.0",
    "react": "^18.2.0"
  }
}
